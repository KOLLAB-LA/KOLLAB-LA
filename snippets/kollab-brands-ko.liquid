<script async src="https://www.instagram.com/embed.js"></script>
<script>
(function(){
  var f=document.getElementById('kb-brand-form');
  if(!f)return;
  try{
    var q=new URLSearchParams(location.search),src=[];
    ['utm_source','utm_medium','utm_campaign','utm_content','utm_term'].forEach(function(k){if(q.get(k))src.push(k+'='+q.get(k));});
    if(!src.length&&document.referrer)src.push('ref='+document.referrer);
    var s=document.getElementById('kb-source');if(s)s.value=src.join('&');
  }catch(e){}
  f.addEventListener('submit',function(){
    var v=[];f.querySelectorAll('input[name="kb-interest"]:checked').forEach(function(c){v.push(c.value);});
    var h=document.getElementById('kb-interests');if(h)h.value=v.join(', ');
  });
})();
</script>
