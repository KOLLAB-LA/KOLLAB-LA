{%- comment -%}
  KOLLAB sales pause (store move, Nov–Dec 2026).
  Disables every add-to-cart / buy / checkout control site-wide.
  To reopen: remove the `render 'kollab-sales-pause'` line in layout/theme.liquid.
{%- endcomment -%}
{%- assign ksp_label = 'Shipping Available December 2026' -%}
<style>
  .shopify-payment-button,
  .nwip-more-payment,
  .nwip-dynamic-checkout,
  .quick-add,
  quick-add-modal,
  [aria-label="quick-add"],
  .nwip-qty,
  #nwipQtyInput,
  form[action*="/cart/add"] .qty,
  form[action*="/cart/add"] .cta2,
  #kd-buy, #kp-buy, #km-buy { display: none !important; }
  /* paused button look: solid, calm, no hover motion */
  .ksp-off, .ksp-off:hover, .ksp-off:focus {
    opacity: 1 !important;
    cursor: default !important;
    pointer-events: none !important;
    transform: none !important;
    box-shadow: none !important;
    background: #0A0A0A !important;
    border-color: #0A0A0A !important;
    color: #fff !important;
    white-space: nowrap !important;
    letter-spacing: .08em !important;
    text-transform: uppercase !important;
    font-weight: 700 !important;
    font-size: 13px !important;
  }
  /* brand PDPs (DE:MAF / Ciel / MUZMAK): qty + buy-now hidden, button spans the row */
  form[action*="/cart/add"].buy { grid-template-columns: 1fr !important; grid-template-rows: 54px !important; }
  form[action*="/cart/add"].buy .ksp-off { grid-column: 1 / -1 !important; grid-row: 1 !important; width: 100% !important; }
  /* main PDP (nest-wip-v2) */
  #nwip-form { grid-template-columns: 1fr !important; grid-template-rows: auto !important; row-gap: 0 !important; }
  #nwip-form .nwip-atc.ksp-off { grid-column: 1 / -1 !important; grid-row: auto !important; width: 100% !important; }
  /* product-card pills */
  [data-add].ksp-off { font-size: 12px !important; padding: 12px 18px !important; letter-spacing: .06em !important; }
  @media (max-width: 749px) {
    .ksp-off { font-size: 12px !important; letter-spacing: .05em !important; padding-left: 12px !important; padding-right: 12px !important; }
    [data-add].ksp-off { font-size: 10.5px !important; padding: 10px 12px !important; letter-spacing: .04em !important; }
  }
</style>
<script>
(function () {
  var LABEL = {{ ksp_label | json }};
  var SHORT = 'Shipping Dec 2026';
  var SHORT_SEL = '[data-add], .nwip-sticky-btn, #kd-sticky, #kp-sticky, #km-sticky';
  var SEL = [
    'form[action*="/cart/add"] button[type="submit"]',
    'form[action*="/cart/add"] input[type="submit"]',
    '#nwipAtc', '.nwip-sticky-btn',
    '#kp-atc', '#km-atc', '#kd-atc',
    '#kp-sticky', '#km-sticky', '#kd-sticky',
    '[data-add]',
    'button[name="add"]', 'button[name="checkout"]', 'input[name="checkout"]'
  ].join(',');

  function lock(el) {
    var txt = el.matches(SHORT_SEL) ? SHORT : LABEL;
    if (el.dataset.ksp === '1' && (el.value || el.textContent).trim() === txt) return;
    el.dataset.ksp = '1';
    el.disabled = true;
    el.removeAttribute('onclick');
    el.classList.add('ksp-off');
    if (el.tagName === 'INPUT') el.value = txt; else el.textContent = txt;
  }
  function run() { document.querySelectorAll(SEL).forEach(lock); }

  // Block any submit to cart/add or checkout
  document.addEventListener('submit', function (e) {
    var a = (e.target.getAttribute('action') || '');
    if (/\/cart\/add|\/checkout/.test(a) || (e.submitter && e.submitter.name === 'checkout')) {
      e.preventDefault(); e.stopImmediatePropagation();
    }
  }, true);
  document.addEventListener('click', function (e) {
    var t = e.target.closest && e.target.closest(SEL + ',a[href*="/checkout"]');
    if (t) { e.preventDefault(); e.stopImmediatePropagation(); }
  }, true);

  // Block AJAX add-to-cart
  var _fetch = window.fetch;
  window.fetch = function (input) {
    var u = typeof input === 'string' ? input : (input && input.url) || '';
    if (/\/cart\/add/.test(u)) return Promise.reject(new Error('Sales paused'));
    return _fetch.apply(this, arguments);
  };
  var _open = XMLHttpRequest.prototype.open;
  XMLHttpRequest.prototype.open = function (m, u) {
    if (/\/cart\/add/.test(u || '')) { this._kspBlocked = true; }
    return _open.apply(this, arguments);
  };
  var _send = XMLHttpRequest.prototype.send;
  XMLHttpRequest.prototype.send = function () {
    if (this._kspBlocked) { this.abort(); return; }
    return _send.apply(this, arguments);
  };

  run();
  document.addEventListener('DOMContentLoaded', run);
  new MutationObserver(run).observe(document.documentElement, { childList: true, subtree: true, characterData: true });
})();
</script>
